# Copy to .env and fill in real values:  cp .env.example .env
VERSION="0.1.0"

# Postgres connection (consumed by docker-compose.yml and app.core.config)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fastapi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# JWT auth (consumed by app.core.config). Generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
